[Unit]
Description=Remove old Docker images, containers and build cache
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
# Only stopped containers and unused images go. Running jobs keep theirs.
ExecStart=/usr/bin/docker system prune --all --force --filter until=168h
ExecStart=/usr/bin/docker builder prune --all --force --filter until=168h
